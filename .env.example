# Projeto Supabase isolado de desenvolvimento. Nunca usar produção nos testes.
# URL HTTPS do projeto, nunca uma chave sb_publishable_ ou conexão PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública anon ou sb_publishable_. Nunca usar sb_secret_ ou service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origem confiável para links de recuperação; configurar também no Supabase Auth.
APP_URL=http://localhost:3000
# Somente no servidor: necessária para criar usuários no Painel Admin.
# Nunca prefixar com NEXT_PUBLIC_, enviar ao cliente ou versionar o valor.
SUPABASE_SERVICE_ROLE_KEY=
